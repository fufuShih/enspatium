{
  "name": "@enspatium/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts",
    "db:migrate": "node --env-file=../../.env --import=tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/env": "^7.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.29.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
