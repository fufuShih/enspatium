# Copy to deploy/.env. Generate each secret independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
SESSION_KEY=
SITE_ADDRESS=https://git.example.com
ENSPATIUM_IMAGE_TAG=local

# Optional host port overrides (use loopback for a local deployment test).
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
