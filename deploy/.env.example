# Copy to deploy/.env. Generate each secret independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
SESSION_KEY=
SITE_ADDRESS=https://git.example.com
ENSPATIUM_IMAGE_TAG=local
REGISTRATION_ENABLED=false

# Git limits are bytes, except the concurrent top-level command count.
GIT_MAX_CONCURRENT_PROCESSES=4
GIT_MAX_PUSH_BYTES=104857600
GIT_REPOSITORY_MAX_BYTES=1073741824
STORAGE_MIN_FREE_BYTES=1073741824

# Optional host port overrides (use loopback for a local deployment test).
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
