# Copy beside compose.yaml as .env on the deployment host.
# In a development checkout, use deploy/.env and --env-file deploy/.env instead.
# Generate two independent random 64-character hex strings for these secrets.
POSTGRES_PASSWORD=
SESSION_KEY=
SITE_ADDRESS=https://git.example.com

# Optional: defaults already use the published Docker Hub release.
# ENSPATIUM_IMAGE_PREFIX=felixshih/
# ENSPATIUM_IMAGE_TAG=v0.1.0
# REGISTRATION_ENABLED=false
